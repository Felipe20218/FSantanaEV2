<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefWidth="780" prefHeight="600"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.duoc.librovivo.controller.MainController">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <Label text="Biblioteca Municipal LibroVivo" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="8">
        <Label text="Tipo" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cmbTipo" promptText="Seleccione tipo" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="Título" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtTitulo" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Año de publicación" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtAnio" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Copias disponibles" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtCopias" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Autor (libro)" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtAutor" prefWidth="200" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
        <CheckBox fx:id="chkBuenEstado" text="Buen estado de conservación" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        <CheckBox fx:id="chkReservado" text="Reservado" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        <Label text="Duración en min (audiolibro)" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <TextField fx:id="txtDuracion" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10">
        <Button fx:id="btnRegistrar" text="Registrar" onAction="#onRegistrar"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar"/>
    </HBox>

    <Label fx:id="lblMensaje" wrapText="true" minHeight="40"/>

    <TableView fx:id="tblMateriales" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
            <TableColumn fx:id="colTitulo" text="Título" prefWidth="280"/>
            <TableColumn fx:id="colAnio" text="Año" prefWidth="80"/>
            <TableColumn fx:id="colCopias" text="Copias" prefWidth="80"/>
            <TableColumn fx:id="colCosto" text="Costo préstamo" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>